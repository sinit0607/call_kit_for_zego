<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Almost every call permission (RECORD_AUDIO, CAMERA, INTERNET,
         POST_NOTIFICATIONS, MANAGE_OWN_CALLS, USE_FULL_SCREEN_INTENT, the
         FOREGROUND_SERVICE_* set, WAKE_LOCK, VIBRATE) is merged in
         automatically from flutter_callkit_incoming's own manifest, so it is
         NOT repeated here. Only what the merger does not give you: -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Declaring the hardware as optional keeps audio-only devices eligible
         on the Play Store; without this the store hides the app from any
         device with no camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="call_kit_for_zego_example"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- NOTE: `flutter create` emits android:taskAffinity="" on this
             activity. It is deliberately omitted. flutter_callkit_incoming
             launches MainActivity with FLAG_ACTIVITY_NEW_TASK when a call is
             accepted; with an empty affinity Android cannot reuse the running
             task, so it starts a SECOND MainActivity in a SECOND task — a
             fresh route stack that shows a black screen, plus a duplicate
             entry in recents. Sharing the default affinity lets the existing
             task be brought forward instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
